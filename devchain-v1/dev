#!/usr/bin/env bash
# Entry point of the development chain. Guide: docs/devchain/README.md
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v uv >/dev/null 2>&1; then
  exec uv run --quiet --project "$root/devchain" devchain "$@"
fi
exec env PYTHONPATH="$root/devchain/src${PYTHONPATH:+:$PYTHONPATH}" python3 -m devchain "$@"
